{
  "name": "the-learning-education-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "react-snap || echo react-snap finished with warnings",
    "build:full": "npm run build && python scripts/generate_markdown_mirrors.py && python scripts/update_llms_mirrors.py",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "skipThirdPartyRequests": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "renderAfterTime": 8000,
    "maxConcurrentRoutes": 1,
    "include": [
      "/",
      "/about",
      "/services",
      "/fee-structure",
      "/teacher-details",
      "/contact",
      "/faq",
      "/terms-and-condition",
      "/resources",
      "/subjects/maths",
      "/subjects/english",
      "/subjects/science",
      "/subjects/science-subjects",
      "/test-prep",
      "/test-prep/sat-act",
      "/teaching-methods"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mantine/core": "^7.17.2",
    "@mui/icons-material": "^6.4.7",
    "@mui/joy": "^5.0.0-beta.51",
    "@mui/material": "^6.4.7",
    "@reduxjs/toolkit": "^2.6.1",
    "@tailwindcss/vite": "^4.0.14",
    "axios": "^1.8.2",
    "bootstrap": "^5.3.3",
    "embla-carousel-autoplay": "^8.5.2",
    "embla-carousel-react": "^8.5.2",
    "formik": "^2.4.6",
    "framer-motion": "^12.5.0",
    "postcss-import": "^16.1.0",
    "react": "^18.3.1",
    "react-accessible-accordion": "^5.0.0",
    "react-bootstrap": "^2.10.9",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.5.0",
    "react-owl-carousel": "^2.3.3",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.3.0",
    "react-toastify": "^11.0.5",
    "swiper": "^11.2.5",
    "tailwindcss": "^4.0.14",
    "typed.js": "^3.0.0",
    "yup": "1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "react-snap": "^1.23.0",
    "terser": "^5.46.2",
    "vite": "^5.4.1"
  }
}
